{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Inkveil",
  "version": "0.0.0",
  "identifier": "com.inkveil.editor",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "隐墨",
        "width": 1100,
        "height": 760,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "txt", "mdown", "mkd"],
        "name": "Markdown Document",
        "role": "Editor"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
