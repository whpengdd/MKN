{
  "name": "mkn",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "本地无缝 Markdown 编辑器(Typora 风格)— Phase 0 内核探针",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "electron:typecheck": "tsc --noEmit -p electron/tsconfig.json",
    "electron:dev": "MKN_ELECTRON=1 vite",
    "electron:build": "MKN_ELECTRON=1 vite build && electron-builder"
  },
  "dependencies": {
    "@codemirror/commands": "^6.6.0",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.2",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.6",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.28.0",
    "@lezer/common": "^1.2.1",
    "@lezer/highlight": "^1.2.0",
    "katex": "^0.16.11",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.4.1"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3",
    "tsx": "^4.19.2",
    "typescript": "^5.4.5",
    "vite": "^5.2.11",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6"
  },
  "build": {
    "appId": "com.mkn.editor",
    "productName": "MKN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "dir"
      ]
    }
  }
}
